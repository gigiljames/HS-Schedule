# Server configuration
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/hs_schedule_planner

# Frontend URLs for CORS
ADMIN_WEB_URL=http://localhost:5173
HS_PWA_URL=http://localhost:5174

# Google OAuth Client ID (for verifying HS Google ID tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Authentication
JWT_ACCESS_SECRET=your-32-character-or-longer-access-secret-key-here
JWT_REFRESH_SECRET=your-32-character-or-longer-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Administrator Bootstrap (auto-created on first boot if no admin exists)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePass2026!
ADMIN_BOOTSTRAP_EMAIL=admin@institution.edu

# Web Push VAPID credentials (generate via web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@institution.edu
